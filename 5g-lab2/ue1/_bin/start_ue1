#!/bin/bash

LOGFILE=$HOME/ue1.log

echo "======================================"
echo "        Starting 5G UE1"
echo "======================================"

# lancer le UE en arrière-plan
sudo nohup /ueransim/bin/nr-ue -c /ueransim/config/open5gs-ue1.yaml > "$LOGFILE" 2>&1 &

echo "UE process started..."
echo "Waiting for 5G registration..."

# attendre l'interface 5G
while ! ip a | grep -q uesimtun0; do
    sleep 1
done

# récupérer IP du tunnel
IP=$(ip -4 -br a | grep uesimtun0 | awk '{print $3}')

# récupérer gateway
GW=$(echo $IP | cut -d/ -f1)

# configurer route
sudo ip route replace default via $GW dev uesimtun0

echo ""
echo "UE REGISTERED TO 5G NETWORK with DNN cloud"
echo "Default route configured"
echo ""
echo "Check interface:"
ip a show uesimtun0
echo ""
echo "To view logs:"
echo "tail -f $LOGFILE"
echo "======================================"
