#!/bin/sh -e
#
# rc.local
#
# This script is executed at the end of each multiuser runlevel.
# Make sure that the script will "exit 0" on success or any other
# value on error.
#
# In order to enable or disable this script just change the execution
# bits.
#
# By default this script does nothing.

# rc.local pour edge_server

# attendre que UPF1 soit joignable (100.0.0.8)
until ping -c1 -W1 100.0.0.8 >/dev/null 2>&1; do
    echo "Waiting for UPF1..."
    sleep 2
done

# ajouter la route vers le réseau cloud (UE)
ip route add 10.0.100.0/24 via 100.0.0.8
exit 0
