#!/bin/sh -e
#
# rc.local
#
# This script is executed at the end of each multiuser runlevel.
# Make sure that the script will "exit 0" on success or any other
# value on error.
#
# In order to enable or disable this script just change the execution
# bits.
#
# By default this script does nothing.

wait_for () {
        for S in $*
        do
                S=`echo $S | tr ":" " "`
                while( ! (perl -e 'print "PRI * HTTP/2.0\r\n\r\n"' | nc -N $S) ) ; do sleep 1; done;
        done
}

( 
	ip tuntap add name ogstun mode tun
	ip addr add 10.0.100.1/24 dev ogstun
	ip addr add 2001:0230:cafe:0000:0000:0000:0000:0001/48 dev ogstun
	ip link set ogstun mtu 1450
	ip link set ogstun up

	iptables -t nat -A POSTROUTING -s 10.0.100.0/24 ! -o ogstun -j MASQUERADE; 
	iptables -A INPUT -i ogstun -j ACCEPT; 

) >> /tmp/log

(
	wait_for smf1:7777
	#H=`hostname`; cd /open5gs/install/bin; ./open5gs-${H}d > /var/log/$H.log 2>&1 & 
	/open5gs/install/bin/open5gs-upfd > /var/log/upf1.log 2>&1 &
	# attendre que ogstun soit créé
        sleep 5

        tc qdisc add dev ogstun root netem delay 100ms
) 

exit 0
